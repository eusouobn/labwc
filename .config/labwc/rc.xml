<?xml version="1.0"?>
<labwc_config>

  <keyboard>

<keybind key="A-Tab">
  <action name="NextWindow"/>
</keybind>

<keybind key="A-S-Tab">
  <action name="PreviousWindow"/>
</keybind>

    <!-- Terminal -->
    <keybind key="W-T">
      <action name="Execute">
        <command>konsole</command>
      </action>
    </keybind>

    <!-- Launcher -->
    <keybind key="W-R">
      <action name="Execute">
        <command>fuzzel</command>
      </action>
    </keybind>

<!-- Fuzzel (app drawer) -->
    <keybind key="W-A">
      <action name="Execute">
        <command>fuzzel</command>
      </action>
    </keybind>


    <!-- Histórico da área de transferência -->
    <keybind key="W-V">
      <action name="Execute">
        <command>sh -c 'cliphist list | fuzzel --dmenu | cliphist decode | wl-copy'</command>
      </action>
    </keybind>


    <!-- Arquivos -->
    <keybind key="W-E">
      <action name="Execute">
        <command>dolphin</command>
      </action>
    </keybind>

    <!-- Firefox -->
    <keybind key="W-X">
      <action name="Execute">
        <command>firefox</command>
      </action>
    </keybind>

    <!-- Fechar janela -->
    <keybind key="W-Q">
      <action name="Close"/>
    </keybind>

    <!-- Toggle fullscreen -->
    <keybind key="W-F">
      <action name="ToggleFullscreen"/>
    </keybind>

    <!-- Toggle waybar -->
    <keybind key="W-Escape">
      <action name="Execute">
        <command>pkill waybar || waybar</command>
      </action>
    </keybind>

    <!-- Desligar -->
    <keybind key="W-space">
      <action name="Execute">
        <command>poweroff</command>
      </action>
    </keybind>

    <!-- Logout -->
    <keybind key="W-L">
      <action name="Execute">
        <command>labwc --exit</command>
      </action>
    </keybind>

    <!-- Screenshot: tela inteira + salvar + copiar -->
    <keybind key="Print">
      <action name="Execute">
        <command>sh -c 'mkdir -p "$HOME/Imagens/Screenshots"; f="$HOME/Imagens/Screenshots/$(date +%F_%T).png"; grim "$f" &amp;&amp; wl-copy &lt; "$f"'</command>
      </action>
    </keybind>

    <!-- Labwc Configurator -->
    <keybind key="W-C">
      <action name="Execute">
        <command>konsole --nofork --hold -e bash "$HOME/labwc/.config/scripts/labwc-config.sh"</command>
      </action>
    </keybind>

  </keyboard>

<theme>
    <name>OB-Tokyonight-Dark</name>
    <font place="ActiveWindow"><name>Ubuntu</name><size>12</size><weight>bold</weight></font>
    <font place="InactiveWindow"><name>Ubuntu</name><size>12</size><weight>bold</weight></font>
</theme>




<focus>
  <followMouse>false</followMouse>
</focus>

</labwc_config>
