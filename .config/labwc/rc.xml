<?xml version="1.0"?>
<labwc_config>

  <keyboard>

<keybind key="A-Tab">
  <action name="NextWindow"/>
</keybind>

<keybind key="A-S-Tab">
  <action name="PreviousWindow"/>
</keybind>

    <!-- Terminal -->
    <keybind key="W-T">
      <action name="Execute">
        <command>xfce4-terminal</command>
      </action>
    </keybind>

    <!-- Launcher -->
    <keybind key="W-R">
      <action name="Execute">
        <command>fuzzel --drun</command>
      </action>
    </keybind>

<!-- Fuzzel (app drawer) -->
    <keybind key="W-A">
      <action name="Execute">
        <command>fuzzel --drun</command>
      </action>
    </keybind>


    <!-- Arquivos -->
    <keybind key="W-E">
      <action name="Execute">
        <command>thunar</command>
      </action>
    </keybind>

    <!-- Firefox -->
    <keybind key="W-X">
      <action name="Execute">
        <command>firefox</command>
      </action>
    </keybind>

    <!-- Fechar janela -->
    <keybind key="W-Q">
      <action name="Close"/>
    </keybind>

    <!-- Toggle fullscreen -->
    <keybind key="W-F">
      <action name="ToggleFullscreen"/>
    </keybind>

    <!-- Toggle waybar -->
    <keybind key="W-Escape">
      <action name="Execute">
        <command>pkill waybar || waybar</command>
      </action>
    </keybind>

    <!-- Desligar -->
    <keybind key="W-space">
      <action name="Execute">
        <command>poweroff</command>
      </action>
    </keybind>

#Screenshot

<keybind key="W-F10">
  <action name="Execute">
    <command>sh -c 'grim ~/Imagens/Screenshots/$(date +%F_%T).png'</command>
  </action>
</keybind>

    <!-- Labwc Configurator -->
    <keybind key="W-C">
      <action name="Execute">
        <command>xfce4-terminal --command "$HOME/labwc/.config/scripts/labwc-config.sh"</command>
      </action>
    </keybind>

  </keyboard>

<theme>
    <name>OB-Tokyonight-Dark</name>
    <font place="ActiveWindow"><name>Ubuntu</name><size>12</size><weight>bold</weight></font>
    <font place="InactiveWindow"><name>Ubuntu</name><size>12</size><weight>bold</weight></font>
</theme>




<focus>
  <followMouse>false</followMouse>
</focus>

</labwc_config>
